{
  "extends": "@madart/config/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "declarationMap": false,
    "removeComments": true
  },
  "include": [
    "src",
    "test"
  ]
}
