{
  "name": "@madart/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, generated client and seed data.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma --ignore-pattern src/generated",
    "migrate": "prisma migrate dev && prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "clean": "rimraf dist src/generated",
    "clean:data": "tsx prisma/clean.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@madart/domain": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@madart/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.0",
    "eslint": "^9.36.0",
    "prisma": "^7.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0"
  }
}
