# --- Database -------------------------------------------------------------
# Docker Compose:   postgresql://madart:madart@localhost:5432/madart
# Embedded (pnpm db:local): postgresql://madart:madart@localhost:5433/madart
DATABASE_URL=postgresql://madart:madart@localhost:5433/madart

# --- Redis (optional; leave empty for single-instance in-memory event bus) ----
REDIS_URL=

# --- API ------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
JWT_SECRET=change-me-in-production-please-32-chars-min
JWT_ACCESS_TTL=12h
DEVICE_TOKEN_TTL=3650d
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:5173,http://localhost:5174,http://localhost:5175
LOG_LEVEL=info

# --- Payment adapters -----------------------------------------------------
PAYMENT_TERMINAL_PROVIDER=MOCK_TERMINAL
MOCK_TERMINAL_DELAY_MS=1500

# --- Frontends ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
