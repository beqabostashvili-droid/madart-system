{
  "name": "@madart/api",
  "version": "0.1.0",
  "private": true,
  "description": "Central backend: REST API, Order Engine, scheduler, realtime gateway.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --exclude test/e2e/** --passWithNoTests",
    "test:e2e": "vitest run test/e2e",
    "test:all": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@madart/database": "workspace:*",
    "@madart/domain": "workspace:*",
    "@madart/hardware-adapters": "workspace:*",
    "@madart/types": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@madart/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.0"
  }
}
