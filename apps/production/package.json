{
  "name": "production",
  "version": "0.1.0",
  "private": true,
  "description": "Production / KDS screen per station (Windows). Vite + React, Electron shell.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron electron/main.cjs"
  },
  "dependencies": {
    "@madart/api-client": "workspace:*",
    "@madart/domain": "workspace:*",
    "@madart/types": "workspace:*",
    "@madart/ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@madart/config": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "eslint": "^9.36.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0"
  }
}
