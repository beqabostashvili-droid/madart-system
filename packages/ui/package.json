{
  "name": "@madart/ui",
  "version": "0.1.0",
  "private": true,
  "description": "MADART design system: tokens, Tailwind theme, touch-first React components, toast/modal system, realtime hooks.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@madart/api-client": "workspace:*",
    "@madart/domain": "workspace:*",
    "@madart/hardware-adapters": "workspace:*",
    "@madart/types": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@madart/config": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.36.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0"
  }
}
